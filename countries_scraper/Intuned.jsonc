{
  "apiAccess": {
    "enabled": false
  },
  "authSessions": {
    "enabled": false
  },
  "replication": {
    "maxConcurrentRequests": 1,
    "size": "standard"
  },
  "metadata": {
    "defaultRunPlaygroundInput": {
      "apiName": "scrape-countries",
      "parameters": {}
    },
    "template": {
      "name": "starter",
      "description": "Default Intuned project template for browser automation",
      "tags": [
        "starter",
        "browser-sdk"
      ]
    }
  },
  "projectName": "countries_scraper"
}